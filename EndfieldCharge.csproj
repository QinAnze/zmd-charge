<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EndfieldCharge</AssemblyName>
    <RootNamespace>EndfieldCharge</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 单文件发布，方便丢进开机启动 -->
    <PublishSingleFile Condition="'$(Configuration)'=='Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)'=='Release'">false</SelfContained>
    <!-- 无条件下发给 restore：CI 里 restore 不带 -c Release，若只有条件 RuntimeIdentifier，
         assets 里就不会有 net8.0-windows/win-x64 目标，build/publish 会报
         "Assets file doesn't have a target for 'net8.0-windows/win-x64'" -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Configuration)'=='Release'">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <!-- WMI（电池兜底、设备类型 PCSystemType） -->
    <PackageReference Include="System.Management" Version="10.0.11" />
    <!-- C 盘所在物理盘的读写速度：PhysicalDisk 性能计数器（实例名自带盘符映射） -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!--
      硬件传感器：LibreHardwareMonitorLib（MIT，AIDA64 / HWiNFO 同源的开源实现）。
      CPU / 内存 / GPU 占用率与 CPU 封装、GPU 实时功率全部读真实传感器，不做估算。
      CPU 封装功率需要加载内核驱动（WinRing0，库内自带、运行时自动解压），
      因此读 CPU 功率需以管理员身份运行；GPU 功率走 NVML / ADL，普通权限即可。
    -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre731" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
