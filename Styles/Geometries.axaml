<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       图标几何：统一 24×24 网格，单色（无 emoji）。
       第三方图标已按各自原始网格（960 / 16 / 256）等比归一化到 24×24，
       来源与许可证见根目录 THIRD-PARTY-NOTICES.md。
       ============================================================ -->

  <!-- 闪电：HUD 主图标，由上下两个平行四边形 fill 拼成（参考原视频）
       底边比顶边宽（梯形），让电标看着更宽更稳。
       充电 / 电池 / 充电中电池三种状态共用此图标（按需求保留）。 -->
  <StreamGeometry x:Key="Geo.Bolt">M13 2 L4 13 L12 13 L18 2 Z M13 11 L20 11 L13 22 L4 22 Z</StreamGeometry>

  <!-- 插头 / 交流：拔电或未接电源时的备用图标。
       main 线的适配器药丸徽章正在用（PR #8 引用点），此处保留原样。 -->
  <StreamGeometry x:Key="Geo.Plug">M12 2 C9.24 2 7 4.24 7 7 V10 H9 V7 C9 5.34 10.34 4 12 4 C13.66 4 15 5.34 15 7 V10 H17 V7 C17 4.24 14.76 2 12 2 Z M8 12 H16 V15 C16 17.21 14.21 19 12 19 C9.79 19 8 17.21 8 15 V12 Z M10 19.5 H14 V22 H10 V19.5 Z</StreamGeometry>

  <!-- 开发板：功耗模式徽章（台式机 / 无电池）。
       Material Symbols · Sharp Filled / developer_board · Apache-2.0 -->
  <StreamGeometry x:Key="Geo.DeveloperBoard">M2.25 21 v-18 h18 v3 h1.5 v1.5 h-1.5 v3.75 h1.5 v1.5 h-1.5 v3.75 h1.5 v1.5 h-1.5 v3 H2.25 Z m1.5 -1.5 h15 v-15 H3.75 v15 Z m1.5 -1.5 h6.325 v-5 H5.25 v5 Z m7.075 -8.4 h4.925 v-3.6 H12.325 v3.6 Z M5.25 12.25 h6.325 v-6.25 H5.25 v6.25 Z m7.075 5.75 h4.925 v-7.65 H12.325 v7.65 Z m-8.575 1.5 v-15 v15 Z</StreamGeometry>

  <!-- 笔记本：主药丸右侧圆环内的设备图形。
       Material Symbols · Sharp Filled / laptop_mac · Apache-2.0 -->
  <StreamGeometry x:Key="Geo.LaptopMac">M0 20 v-1.5 h2.775 l-0.75 -0.75 v-14.75 h19.95 v14.75 l-0.75 0.75 h2.775 v1.5 H0 Z m12 -0.55 q0.361 0 0.606 -0.244 Q12.85 18.961 12.85 18.6 q0 -0.361 -0.244 -0.606 Q12.361 17.75 12 17.75 q-0.361 0 -0.606 0.244 Q11.15 18.239 11.15 18.6 q0 0.361 0.244 0.606 Q11.639 19.45 12 19.45 Z m-8.475 -2.45 h16.95 v-12.5 H3.525 v12.5 Z m0 0 v-12.5 v12.5 Z</StreamGeometry>

  <!-- 速度表：性能面板展开后的方形态图标。
       Bootstrap Icons / speedometer2 · MIT
       原图标第二个子路径依赖 evenodd 挖空表盘内圈，用 GeometryGroup 保留
       独立子路径与 FillRule；合并成单个 StreamGeometry 会把表盘填实。 -->
  <GeometryGroup x:Key="Geo.Speedometer" FillRule="EvenOdd">
    <StreamGeometry>M12 6 a0.75 0.75 0 0 1 0.75 0.75 V9 a0.75 0.75 0 0 1 -1.5 0 V6.75 A0.75 0.75 0 0 1 12 6 M5.598 8.598 a0.75 0.75 0 0 1 1.06 0 l1.373 1.371 a0.75 0.75 0 1 1 -1.062 1.062 l-1.371 -1.373 a0.75 0.75 0 0 1 0 -1.06 M3 15 a0.75 0.75 0 0 1 0.75 -0.75 h2.379 a0.75 0.75 0 0 1 0 1.5 H3.75 A0.75 0.75 0 0 1 3 15 m14.25 0 a0.75 0.75 0 0 1 0.75 -0.75 h2.25 a0.75 0.75 0 0 1 0 1.5 H18 a0.75 0.75 0 0 1 -0.75 -0.75 m1.131 -6.369 a0.585 0.585 0 0 0 -0.79 -0.03 L11.32 13.965 a1.365 1.365 0 1 0 1.953 1.887 l5.151 -6.445 a0.585 0.585 0 0 0 -0.044 -0.777 Z</StreamGeometry>
    <StreamGeometry>M0 15 a12 12 0 1 1 23.321 3.992 c-0.663 1.879 -2.768 2.403 -4.398 1.875 C16.963 20.232 14.212 19.5 12 19.5 c-2.211 0 -4.965 0.732 -6.923 1.367 c-1.631 0.528 -3.735 0.005 -4.398 -1.875 A12 12 0 0 1 0 15 m12 -10.5 a10.5 10.5 0 0 0 -9.904 13.994 c0.304 0.862 1.385 1.314 2.52 0.945 C6.596 18.799 9.537 18 12 18 s5.406 0.798 7.385 1.44 c1.135 0.367 2.216 -0.084 2.52 -0.947 A10.5 10.5 0 0 0 12 4.5</StreamGeometry>
  </GeometryGroup>

  <!-- 叶子：省电 / 节能模式。Phosphor Icons / leaf-fill · MIT -->
  <StreamGeometry x:Key="Geo.Leaf">M20.948 3.757 a0.75 0.75 0 0 0 -0.705 -0.705 C13.106 2.632 7.389 4.781 4.952 8.812 a8.165 8.165 0 0 0 -1.196 4.594 A9.536 9.536 0 0 0 4.378 16.425 a0.375 0.375 0 0 0 0.62 0.134 l7.969 -8.091 a0.75 0.75 0 0 1 1.061 1.061 L5.319 18.369 L3.989 19.7 a0.769 0.769 0 0 0 -0.056 1.041 a0.75 0.75 0 0 0 1.098 0.04 l1.574 -1.574 c1.326 0.641 2.663 0.991 3.99 1.038 q0.157 0.006 0.312 0.006 A8.15 8.15 0 0 0 15.188 19.048 C19.219 16.611 21.368 10.895 20.948 3.757 Z</StreamGeometry>

  <!-- 线缆：适配器药丸徽章（替换 Geo.Plug）。Material Symbols · Sharp Filled / cable · Apache-2.0 -->
  <StreamGeometry x:Key="Geo.Cable">M3 19 v-4.5 h2 v-7.75 q0 -1.6 1.175 -2.675 t2.825 -1.075 q1.575 0 2.663 1.088 T12.75 6.75 v10.5 q0 0.95 0.65 1.6 t1.6 0.65 q1.025 0 1.763 -0.638 T17.5 17.25 v-7.75 h-2 v-4.5 h1 v-2 h3.5 v2 h1 v4.5 h-2 v7.75 q0 1.6 -1.175 2.675 t-2.825 1.075 q-1.575 0 -2.663 -1.088 T11.25 17.25 v-10.5 q0 -0.95 -0.65 -1.6 t-1.6 -0.65 q-1.025 0 -1.763 0.638 T6.5 6.75 v7.75 h2 v4.5 h-1 v2 H4 v-2 h-1 Z</StreamGeometry>

