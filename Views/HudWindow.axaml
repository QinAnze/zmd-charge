<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="160"
        x:Class="EndfieldCharge.Views.HudWindow"
        Width="1200" Height="160"
        Title="EndfieldCharge"

        SystemDecorations="None"
        Background="Transparent"

        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        WindowStartupLocation="Manual">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldCharge/Styles/Geometries.axaml"/>
        <ResourceInclude Source="avares://EndfieldCharge/Styles/HudTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 胶囊是固定尺寸的"灵动岛"（560×60），整段动画宽度不变，
       只有 CornerRadius 在全圆(30) ↔ 圆角矩形(12) 之间过渡。
       ScaleHost 收尾整体缩放。 -->
  <Grid x:Name="Root" Width="1200" Height="100" VerticalAlignment="Center">
    <!-- 全局缩放 0.8：整个 HUD 缩小 20% -->
    <Grid x:Name="GlobalScale"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
      </Grid.RenderTransform>

    <Grid x:Name="ScaleHost"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
      </Grid.RenderTransform>

      <!-- ========== 胶囊：固定 560×60 ==========
           PillAppear 让胶囊在电标弹入后 0.14→0.20 之间从中心弹出（scale 0.6→1, op 0→1）。
           RippleHost 在胶囊内部，Pill 的 ClipToBounds + CornerRadius 做圆角裁剪。 -->
      <Border x:Name="Pill"
              Width="560" Height="60"
              CornerRadius="30"
              Background="#FF312F30"
              ClipToBounds="True"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Opacity="0">
        <Border.RenderTransform>
          <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
        </Border.RenderTransform>

        <!-- RippleHost：在 Pill 内部，但无 Width/Height/ClipToBounds，
             仅由 Pill 的 ClipToBounds + CornerRadius 做圆角裁剪。
             Host 的 TranslateY 由 RippleRise 动画驱动
             （16px 电标正下方 → 0 对齐电标圆心），波纹自身 scale 从 0 扩散。 -->
        <Grid x:Name="RippleHost"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False">
          <Grid.RenderTransform>
            <TranslateTransform X="0"/>
          </Grid.RenderTransform>

          <Grid x:Name="RippleInnerHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleInner"
                     Width="160" Height="160"
                     Fill="#FF656363"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <Grid x:Name="RippleMidHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleMid"
                     Width="220" Height="220"
                     Stroke="#FF656363" StrokeThickness="5.0"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <Grid x:Name="RippleOuterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleOuter"
                     Width="280" Height="280"
                     Stroke="#FF656363" StrokeThickness="3.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Grid>
      </Border>

      <!-- ========== 电的图标：居中 → 左移（展开）→ 贴左（收窄），形态圆 → 方 ==========
           电标先弹出（0.08→0.14），然后胶囊在它身后弹出 -->
      <Grid x:Name="BoltIcon"
            Width="32" Height="32"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Opacity="0">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
            <TranslateTransform X="0"/>
          </TransformGroup>
        </Grid.RenderTransform>

        <!-- 圆形形态：状态 A 与 B（白圆 32 小一圈，平行四边形 logo 18 占大头） -->
        <Grid x:Name="CircleForm">
          <Ellipse Width="32" Height="32" Fill="#FFE9E7E4"/>
          <PathIcon Width="18" Height="18"
                    Data="{DynamicResource Geo.Bolt}"
                    Foreground="#FF141313"/>
        </Grid>

        <!-- 方形态：状态 C（18×18 圆角方块，在 32×32 容器内居中，logo 12） -->
        <Grid x:Name="SquareForm" Opacity="0">
          <Border Width="18" Height="18"
                  CornerRadius="4.5"
                  Background="#FFE9E7E4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      Data="{DynamicResource Geo.Bolt}"
                      Foreground="#FF141313"/>
          </Border>
        </Grid>
      </Grid>

      <!-- ========== 标题态：「/// INDUSTRIAL MODE」+ 工业模式 ==========
           居中于胶囊（pill 中心 x=600），不跟随电标位移 -->
      <StackPanel x:Name="TitleHost"
                  Orientation="Vertical" Spacing="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0">
        <StackPanel.RenderTransform>
          <TranslateTransform X="0"/>
        </StackPanel.RenderTransform>
        <TextBlock x:Name="TagLineText"
                   Text="/// SUPER CHARGE MODE"
                   FontFamily="{DynamicResource Hud.FontFamily}"
                   FontSize="9" FontWeight="Medium"
                   LetterSpacing="2"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   Opacity="0.40"/>
        <TextBlock x:Name="TitleText"
                   Text="超充模式"
                   FontFamily="{DynamicResource Hud.FontFamily}"
                   FontSize="26" FontWeight="Bold"
                   LetterSpacing="2"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
      </StackPanel>

      <!-- ========== 数字态：瘦长布局——方块+Wh 靠左，% + 徽章 靠右，中间留空 ==========
           NumHost 与 Pill 等宽，* 列撑出中间约 55% 空白 -->
      <Grid x:Name="NumHost"
            Width="560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Opacity="0">
        <Grid.RenderTransform>
          <TranslateTransform X="0"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26"/>    <!-- 左内边距（电标/数字离左边远一点） -->
          <ColumnDefinition Width="18"/>    <!-- 方块占位（方块由 BoltIcon 提供） -->
          <ColumnDefinition Width="6"/>     <!-- 间隙 -->
          <ColumnDefinition Width="Auto"/>  <!-- Wh 组 -->
          <ColumnDefinition Width="*"/>     <!-- 中间留空 -->
          <ColumnDefinition Width="Auto"/>  <!-- 百分比 -->
          <ColumnDefinition Width="14"/>    <!-- 间隙 -->
          <ColumnDefinition Width="Auto"/>  <!-- 徽章 -->
          <ColumnDefinition Width="5"/>     <!-- 右内边距（徽章贴右但不完全贴死） -->
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="3" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="WhValueText"
                     Text="0.0"
                     FontFamily="{DynamicResource Hud.FontFamily}"
                     FontSize="26" FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock x:Name="WhMaxText"
                     Text="/0.0"
                     FontFamily="{DynamicResource Hud.FontFamily}"
                     FontSize="14" FontWeight="Medium"
                     Foreground="White" Opacity="0.55"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="5" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="PercentText"
                     Text="0"
                     FontFamily="{DynamicResource Hud.FontFamily}"
                     FontSize="22" FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock Text="%"
                     FontFamily="{DynamicResource Hud.FontFamily}"
                     FontSize="13" FontWeight="Medium"
                     Foreground="White" Opacity="0.55"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 黄绿电池徽章：46 直径正好被 60 高胶囊包住
             底：暗色圆盘
             外圈：进度圆弧（弧长 = 电量百分比，12 点方向起顺时针），几何在代码里按百分比生成
             颜色：≥20% 黄绿 #C6CA4C，<20% 变红 #FF4D4F
             内部图形 = 笔记本电脑（屏幕描边 + 底座填充） -->
        <Grid x:Name="Badge" Grid.Column="7" Width="46" Height="46" VerticalAlignment="Center">
          <Ellipse Width="46" Height="46" Fill="#FF262425"/>

          <Path x:Name="BadgeArc"
                Width="46" Height="46"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Stretch="None"
                Stroke="#FFC6CA4C" StrokeThickness="4.5"
                StrokeLineCap="Round"/>

          <!-- 笔记本电脑图形：屏幕（描边矩形）+ 底座（填充条） -->
          <Grid x:Name="BadgeLaptop" Width="24" Height="17" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="LaptopScreen"
                    Width="17" Height="11.5" CornerRadius="1.5"
                    BorderBrush="#FFC6CA4C" BorderThickness="2"
                    VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <Border x:Name="LaptopBase"
                    Width="24" Height="3" CornerRadius="1.5"
                    Background="#FFC6CA4C"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
          </Grid>

          <Border x:Name="BadgeElectrode" Width="9" Height="3" CornerRadius="1,1,0,0"
                  Background="#FFC6CA4C"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,-14,0,0"/>
        </Grid>
      </Grid>

    </Grid>
	    </Grid>

	    <!-- FPS 调试计数器（仅 show-fps 参数时可见） -->
	    <TextBlock x:Name="FpsText"
	               HorizontalAlignment="Right" VerticalAlignment="Bottom"
	               FontFamily="{DynamicResource Hud.FontFamily}"
	               FontSize="9" FontWeight="Medium"
	               Foreground="#C6CA4C" Opacity="0.6"
	               Margin="0,0,4,2"
	               IsVisible="False"
	               Text="-- FPS"/>
	  </Grid>
	</Window>
