<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="160"
        x:Class="EndfieldCharge.Views.HudWindow"
        Width="1200" SizeToContent="Height"
        Title="EndfieldCharge"

        SystemDecorations="None"
        Background="Transparent"

        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        WindowStartupLocation="Manual">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EndfieldCharge/Styles/Geometries.axaml"/>
        <ResourceInclude Source="avares://EndfieldCharge/Styles/HudTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 胶囊是固定尺寸的"灵动岛"（560×60），整段动画宽度不变，
       只有 CornerRadius 在全圆(30) ↔ 圆角矩形(12) 之间过渡。
       ScaleHost 收尾整体缩放。
       窗口高度自适应（SizeToContent）：主药丸 + 下方每个适配器一粒药丸。
       上边距 35 + 主药丸区 90：保证单适配器时主药丸视觉位置与旧版固定 160 高窗口完全一致。 -->
  <Grid x:Name="Root" Width="1200">
    <StackPanel x:Name="HudStack"
                Orientation="Vertical"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,35,0,35">
    <!-- 全局缩放 0.8：整个 HUD 缩小 20% -->
    <Grid x:Name="GlobalScale"
          HorizontalAlignment="Center"
          RenderTransformOrigin="50%,50%">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
      </Grid.RenderTransform>

      <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">

      <!-- ScaleHost 固定 560×90（B 态最大高度），子元素垂直居中：
           撑高动画 60↔90 始终绕固定圆心对称展开，布局尺寸不变，不触发窗口重排。 -->
      <Grid x:Name="ScaleHost"
            Width="560" Height="90"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
      </Grid.RenderTransform>

      <!-- ========== 胶囊：固定 560×60 ==========
           PillAppear 让胶囊在电标弹入后 0.14→0.20 之间从中心弹出（scale 0.6→1, op 0→1）。
           RippleHost 在胶囊内部，Pill 的 ClipToBounds + CornerRadius 做圆角裁剪。 -->
      <Border x:Name="Pill"
              Width="560" Height="60"
              CornerRadius="30"
              Background="#FF312F30"
              ClipToBounds="True"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Opacity="0">
        <Border.RenderTransform>
          <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
        </Border.RenderTransform>

        <!-- RippleHost：在 Pill 内部，但无 Width/Height/ClipToBounds，
             仅由 Pill 的 ClipToBounds + CornerRadius 做圆角裁剪。
             Host 的 TranslateY 由 RippleRise 动画驱动
             （16px 电标正下方 → 0 对齐电标圆心），波纹自身 scale 从 0 扩散。 -->
        <Grid x:Name="RippleHost"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False">
          <Grid.RenderTransform>
            <TranslateTransform X="0"/>
          </Grid.RenderTransform>

          <Grid x:Name="RippleInnerHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleInner"
                     Width="160" Height="160"
                     Fill="#FF656363"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <Grid x:Name="RippleMidHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleMid"
                     Width="220" Height="220"
                     Stroke="#FF656363" StrokeThickness="5.0"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <Grid x:Name="RippleOuterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
              <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Ellipse x:Name="RippleOuter"
                     Width="280" Height="280"
                     Stroke="#FF656363" StrokeThickness="3.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" RenderTransformOrigin="50%,50%">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.0" ScaleY="0.0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Grid>
      </Border>

      <!-- ========== 电的图标：居中 → 左移（展开）→ 贴左（收窄），形态圆 → 方 ==========
           电标先弹出（0.08→0.14），然后胶囊在它身后弹出 -->
      <Grid x:Name="BoltIcon"
            Width="32" Height="32"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Opacity="0">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
            <TranslateTransform X="0"/>
          </TransformGroup>
        </Grid.RenderTransform>

        <!-- 圆形形态：状态 A 与 B（白圆 32 小一圈，平行四边形 logo 18 占大头） -->
        <Grid x:Name="CircleForm">
          <Ellipse Width="32" Height="32" Fill="#FFE9E7E4"/>
          <PathIcon x:Name="CircleBoltIcon" Width="18" Height="18"
                    Data="{DynamicResource Geo.Bolt}"
                    Foreground="#FF141313"/>
        </Grid>

        <!-- 方形态：状态 C / 性能面板（18×18 圆角方块在 32×32 容器内居中；
             面板打开时闪电换成速度表图标） -->
        <Grid x:Name="SquareForm" Opacity="0">
          <Border Width="18" Height="18"
                  CornerRadius="4.5"
                  Background="#FFE9E7E4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Panel>
              <PathIcon x:Name="SquareBoltIcon"
                        Width="12" Height="12"
                        Data="{DynamicResource Geo.Bolt}"
                        Foreground="#FF141313"/>
              <PathIcon x:Name="SquarePerfIcon"
                        Width="12" Height="12"
                        Data="{DynamicResource Geo.Speedometer}"
                        Foreground="#FF141313"
                        IsVisible="False"/>
            </Panel>
          </Border>
        </Grid>
      </Grid>

      <!-- ========== 标题态：「/// INDUSTRIAL MODE」+ 工业模式 ==========
           居中于胶囊（pill 中心 x=600），不跟随电标位移 -->
      <StackPanel x:Name="TitleHost"
                  Orientation="Vertical" Spacing="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0">
        <StackPanel.RenderTransform>
          <TranslateTransform X="0"/>
        </StackPanel.RenderTransform>
        <TextBlock x:Name="TagLineText"
                   Text="/// CHARGE MODE"
                   FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                   FontSize="9" FontWeight="Medium"
                   LetterSpacing="2"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   Opacity="0.40"/>
        <TextBlock x:Name="TitleText"
                   Text="充电模式"
                   FontFamily="{DynamicResource Hud.FontFamily}"
                   FontSize="26" FontWeight="Bold"
                   LetterSpacing="2"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
      </StackPanel>

      <!-- ========== 数字态：瘦长布局——方块+Wh 靠左，% + 徽章 靠右，中间留空 ==========
           NumHost 与 Pill 等宽，* 列撑出中间约 55% 空白 -->
      <Grid x:Name="NumHost"
            Width="560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Opacity="0">
        <Grid.RenderTransform>
          <TranslateTransform X="0"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32"/>    <!-- 左内边距（电标/数字离左边远一点） -->
          <ColumnDefinition Width="18"/>    <!-- 方块占位（方块由 BoltIcon 提供） -->
          <ColumnDefinition Width="14"/>    <!-- 间隙（文字离 bolt 图标略远） -->
          <ColumnDefinition Width="Auto"/>  <!-- Wh 组 -->
          <ColumnDefinition Width="*"/>     <!-- 中间留空 -->
          <ColumnDefinition Width="Auto"/>  <!-- 百分比 -->
          <ColumnDefinition Width="14"/>    <!-- 间隙 -->
          <ColumnDefinition Width="Auto"/>  <!-- 徽章 -->
          <ColumnDefinition Width="5"/>     <!-- 右内边距（徽章贴右但不完全贴死） -->
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="3" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="2">
          <!-- 主数值：笔记本是剩余 mWh，台式机是估算功耗 W -->
          <TextBlock x:Name="WhValueText"
                     Text="0.0"
                     FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                     FontSize="26" FontWeight="Medium"
                     Foreground="White"/>
          <!-- 单位：笔记本是 /满电 mWh，台式机是 W -->
          <TextBlock x:Name="WhMaxText"
                     Text="/0.0"
                     FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                     FontSize="14" FontWeight="Medium"
                     Foreground="White" Opacity="0.55"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="5" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="PercentText"
                     Text="0"
                     FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                     FontSize="22" FontWeight="Medium"
                     Foreground="White"/>
          <TextBlock Text="%"
                     FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
                     FontSize="13" FontWeight="Medium"
                     Foreground="White" Opacity="0.55"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 黄绿徽章：46 直径正好被 60 高胶囊包住
             底：暗色圆盘
             外圈：进度圆弧（弧长按百分比在代码里生成，12 点方向起顺时针）
                   笔记本 = 电量百分比；台式机 = 设备负载（CPU+内存+GPU 加权）
             颜色：正常黄绿 #C6CA4C，告警红 #FF4D4F（低电量 / 负载 ≥90%）
             内部图形：电量模式 = 笔记本；功耗模式 = 开发板 -->
        <Grid x:Name="Badge" Grid.Column="7" Width="46" Height="46" VerticalAlignment="Center">
          <Ellipse Width="46" Height="46" Fill="#FF262425"/>

          <Path x:Name="BadgeArc"
                Width="46" Height="46"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Stretch="None"
                Stroke="#FFC6CA4C" StrokeThickness="4.5"
                StrokeLineCap="Round"/>

          <!-- 笔记本：Material Symbols / laptop_mac（Apache-2.0） -->
          <Grid x:Name="BadgeLaptop" Width="24" Height="24"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <PathIcon x:Name="BadgeLaptopIcon"
                      Width="24" Height="24"
                      Data="{DynamicResource Geo.LaptopMac}"
                      Foreground="#FFC6CA4C"/>
          </Grid>

          <!-- 开发板：功耗模式，Material Symbols / developer_board（Apache-2.0） -->
          <Grid x:Name="BadgeChip" Width="24" Height="24"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                IsVisible="False">
            <PathIcon x:Name="BadgeChipIcon"
                      Width="24" Height="24"
                      Data="{DynamicResource Geo.DeveloperBoard}"
                      Foreground="#FFC6CA4C"/>
          </Grid>
        </Grid>
      </Grid>

      <!-- ========== 性能面板：点击圆胶囊形变展开 ==========
           自身透明，背景就是形变中的胶囊（高 60→90、圆角 30→18），
           所以背景与圆角永远和圆角矩形一致。六项指标由代码刷新。 -->
      <Grid x:Name="PerfPanel"
            Width="560" Height="90"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="False" IsHitTestVisible="False"
            Opacity="0">
        <Grid Margin="40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfCpu" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="CPU"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfGpu" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="GPU"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfMem" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="内存"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfDisk" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="硬盘"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfUp" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="上传"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PerfDown" Text="--"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="下载"
                       FontFamily="{DynamicResource Hud.FontFamily}"
                       FontSize="10" FontWeight="Medium" LetterSpacing="1"
                       Foreground="White" Opacity="0.40" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>

    </Grid>

    <!-- ========== 插件适配器药丸：代码动态生成（一适配器一粒），显示在主药丸下方 ========== -->
    <StackPanel x:Name="ExtraPillsHost" Orientation="Vertical" Spacing="10"/>

      </StackPanel>
	    </Grid>
    </StackPanel>

	    <!-- FPS 调试计数器（仅 show-fps 参数时可见） -->
		    <TextBlock x:Name="FpsText"
		               HorizontalAlignment="Right" VerticalAlignment="Bottom"
		               FontFamily="{DynamicResource Hud.FontFamilyNumeric}"
		               FontSize="9" FontWeight="Medium"
		               Foreground="#C6CA4C" Opacity="0.6"
		               Margin="0,0,4,2"
		               IsVisible="False"
		               Text="-- FPS"/>
	  </Grid>
	</Window>
