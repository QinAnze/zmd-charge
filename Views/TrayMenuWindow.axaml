<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EndfieldCharge.Views.TrayMenuWindow"
        Width="220" Height="173"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SystemDecorations="None"
        CanResize="False"
        Focusable="True">

  <!-- 菜单容器：固定 220×173（4项×36 + 1分隔线 + padding + spacing），
       圆角 + 阴影，Padding 6 使内层 item 与外侧有小边距 -->
  <Border CornerRadius="10" Background="#1E1E20" Padding="6"
          BoxShadow="0 4 20 #40000000"
          BorderThickness="1" BorderBrush="#2A2A2C">
    <StackPanel x:Name="MenuStack" Spacing="2"
                VerticalAlignment="Center">

      <!-- 预览电量 HUD -->
      <Border x:Name="MenuPreview" Tag="preview"
              Height="36" CornerRadius="6" Padding="12,0"
              Cursor="Hand" Background="Transparent">
        <TextBlock x:Name="MenuPreviewText"
                   FontSize="13" VerticalAlignment="Center" Foreground="#E8E8E8"/>
      </Border>

      <!-- 设置 -->
      <Border x:Name="MenuSettings" Tag="settings"
              Height="36" CornerRadius="6" Padding="12,0"
              Cursor="Hand" Background="Transparent">
        <TextBlock x:Name="MenuSettingsText"
                   FontSize="13" VerticalAlignment="Center" Foreground="#E8E8E8"/>
      </Border>

      <!-- 检查更新 -->
      <Border x:Name="MenuCheckUpdate" Tag="update"
              Height="36" CornerRadius="6" Padding="12,0"
              Cursor="Hand" Background="Transparent">
        <TextBlock x:Name="MenuCheckUpdateText"
                   FontSize="13" VerticalAlignment="Center" Foreground="#E8E8E8"/>
      </Border>

      <!-- 分隔线 -->
      <Border Height="1" Background="#2A2A2C" Margin="8,4"/>

      <!-- 退出 -->
      <Border x:Name="MenuExit" Tag="exit"
              Height="36" CornerRadius="6" Padding="12,0"
              Cursor="Hand" Background="Transparent">
        <TextBlock x:Name="MenuExitText"
                   FontSize="13" VerticalAlignment="Center" Foreground="#E8E8E8"/>
      </Border>

    </StackPanel>
  </Border>
</Window>